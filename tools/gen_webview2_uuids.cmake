# Generate the IID declarations MinGW needs from WebView2.h (__CRT_UUID_DECL specializations).
#
#   cmake -DHEADER=<path/WebView2.h> -DOUTPUT=<path/WebView2UUIDs.h> -P tools/gen_webview2_uuids.cmake
#
# Why this exists:
#   WebView2.h is a MIDL-generated MSVC header; interface GUIDs only live in the
#   __declspec(uuid("...")) attribute. MSVC resolves __uuidof(IFoo) from that attribute,
#   but MinGW / clang-gnu expands __uuidof into __mingw_uuidof<T>() and needs an explicit
#   __CRT_UUID_DECL specialization, otherwise linking fails with:
#       undefined symbol: _GUID const& __mingw_uuidof<ICoreWebView2Environment>()
#
# Pure CMake on purpose: the build runs it automatically, no PowerShell needed.

cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED HEADER OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "usage: cmake -DHEADER=<WebView2.h> -DOUTPUT=<WebView2UUIDs.h> -P gen_webview2_uuids.cmake")
endif()
if(NOT EXISTS "${HEADER}")
  message(FATAL_ERROR "header not found: ${HEADER}")
endif()

file(READ "${HEADER}" content)

# flatten newlines so a single regex can grab both the GUID and the interface name
string(REPLACE "\r" " " content "${content}")
string(REPLACE "\n" " " content "${content}")

string(REGEX MATCHALL "MIDL_INTERFACE\\(\"[0-9a-fA-F-]+\"\\)[ ]+[A-Za-z_][A-Za-z0-9_]*" snippets "${content}")
list(LENGTH snippets snippet_count)
if(snippet_count EQUAL 0)
  message(FATAL_ERROR "No MIDL_INTERFACE declaration found in ${HEADER}")
endif()

set(body "")
set(seen "")
set(written 0)

foreach(snippet IN LISTS snippets)
  string(REGEX REPLACE "^.*MIDL_INTERFACE\\(\"([0-9a-fA-F-]+)\"\\).*$" "\\1" guid "${snippet}")
  string(REGEX REPLACE "^.*\\)[ ]+([A-Za-z_][A-Za-z0-9_]*)$" "\\1" name "${snippet}")

  list(FIND seen "${name}" duplicate)
  if(NOT duplicate EQUAL -1)
    continue()
  endif()
  list(APPEND seen "${name}")

  string(REPLACE "-" ";" parts "${guid}")
  list(LENGTH parts part_count)
  if(NOT part_count EQUAL 5)
    message(FATAL_ERROR "Cannot parse GUID: ${guid}")
  endif()
  list(GET parts 0 data1)
  list(GET parts 1 data2)
  list(GET parts 2 data3)
  list(GET parts 3 tail_a)
  list(GET parts 4 tail_b)
  set(tail "${tail_a}${tail_b}")

  set(args "0x${data1}" "0x${data2}" "0x${data3}")
  foreach(index RANGE 0 7)
    math(EXPR offset "${index} * 2")
    string(SUBSTRING "${tail}" ${offset} 2 pair)
    list(APPEND args "0x${pair}")
  endforeach()

  string(REPLACE ";" ", " joined "${args}")
  string(APPEND body "__CRT_UUID_DECL(${name}, ${joined})\n")
  math(EXPR written "${written} + 1")
endforeach()

set(header_text
"// Generated by tools/gen_webview2_uuids.cmake -- do not edit by hand.
// Source: third_party/webview2/include/WebView2.h (Microsoft.Web.WebView2 NuGet package)
// Purpose: __CRT_UUID_DECL specializations so __uuidof(ICoreWebView2*) works on MinGW.
#pragma once

#include <guiddef.h>

#ifndef __CRT_UUID_DECL
#error \"Requires mingw-w64 <_mingw.h> (__CRT_UUID_DECL); use a MinGW/clang-mingw toolchain.\"
#endif

#include \"WebView2.h\"

")

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}" "${header_text}${body}")

message(STATUS "wrote ${written} IID declarations -> ${OUTPUT}")
